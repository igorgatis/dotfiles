{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Bash(pushd:*)",
      "Bash(pwd:*)",
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(yadm:*)",
      "WebFetch(domain:google.com)",
      "Bash(~/.claude/skills/tools-inventory/discover.sh:*)",
      "Bash(~/.claude/skills/dotfiles/dotfiles-helper.sh:*)"
    ],
    "deny": []
  },
  "voiceEnabled": true,
  "enabledPlugins": {
    "code-review@claude-plugins-official": true
  }
}
